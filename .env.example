# ==========================================
# AROS Platform Environment Configuration Template
# ==========================================

# --- Relational Database Configuration ---
# PostgreSQL connection string
DATABASE_URL=postgresql://aros:aros123@localhost:5432/aros

# --- Vector Database Configuration ---
# Host and port for Qdrant container
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Graph Database Configuration ---
# URI and authentication credentials for Neo4j Graph DB
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# --- Search Provider API Keys (Optional) ---
# Add your search keys here to unlock additional patent scraping APIs
PATENTSVIEW_API_KEY=
LENS_API_KEY=
USPTO_API_KEY=

# --- Service Provider Endpoints (Default URL configurations) ---
PATENTSVIEW_URL=https://search.patentsview.org/api/v1/patent/
HF_DATASET_API_URL=https://huggingface.co/api/datasets
SEMANTIC_SCHOLAR_URL=https://api.semanticscholar.org/graph/v1/paper/search
OPENALEX_URL=https://api.openalex.org/works

# --- Orchestrator Webhook Configuration ---
# Production webhook url for n8n orchestrator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/research
